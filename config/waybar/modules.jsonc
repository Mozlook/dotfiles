// Shared module definitions — included by every bar style (styles/*/config.jsonc).
// A style can override any field by defining the same module key again; its own
// values win and the rest is inherited from here.
// Icons: Material Symbols Rounded, filled (ttf-material-symbols-variable), wrapped in a
// Pango span — the glyphs share codepoints with Nerd Font icons, so the font must be explicit.
{
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'e+1' })\"",
        "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'e-1' })\"",
        "format-icons": {
            "1": "1",
            "2": "2",
            "3": "3",
            "4": "q",
            "5": "w",
            "6": "e",
            "default": "•"
        }
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true,
        "rewrite": {
            "": "  ~"
        }
    },
    "clock": {
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {:%H:%M}",
        "format-alt": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {:%a, %d %b}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<b><u>{}</u></b>",
                "weekdays": "<i>{}</i>"
            }
        }
    },
    "custom/media": {
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {}",
        "max-length": 38,
        "interval": 2,
        "exec": "playerctl metadata --format '{{title}} — {{artist}}' 2>/dev/null",
        "exec-if": "playerctl status 2>/dev/null | grep -q Playing",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip": false
    },
    "custom/updates": {
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {}",
        "interval": 3600,
        "exec": "checkupdates 2>/dev/null | wc -l",
        "exec-if": "[ $(checkupdates 2>/dev/null | wc -l) -gt 0 ]",
        "on-click": "kitty -e sh -c 'sudo pacman -Syu; echo; read -n1 -p \"Done. Press any key…\"'",
        "tooltip-format": "Pending updates — click to upgrade"
    },
    "backlight": {
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {volume}%",
        "format-icons": {
            "default": [
                "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
                "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
                "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>"
            ],
            "headphone": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>"
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "network": {
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
        "format-disconnected": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
        "tooltip-format": "{ifname}  {ipaddr}",
        "tooltip-format-wifi": "{essid}  ({signalStrength}%)\n{ifname}  {ipaddr}",
        "on-click": "~/.local/bin/network-menu",
        "format-icons": [
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>"
        ]
    },
    "bluetooth": {
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
        "format-disabled": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
        "format-connected": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "blueman-manager",
        "format-off": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {capacity}%",
        "format-plugged": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {capacity}%",
        "format-icons": [
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>"
        ],
        "tooltip-format": "{timeTo}"
    },
    "custom/notifications": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "none": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "dnd-notification": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "dnd-none": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "inhibited-notification": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "inhibited-none": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "dnd-inhibited-notification": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "dnd-inhibited-none": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "custom/theme": {
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
        "tooltip": true,
        "on-click": "~/.local/bin/style-menu",
        "tooltip-format": "Theme / bar style"
    },
    "custom/power": {
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
        "tooltip": false,
        "on-click": "~/.local/bin/power-menu"
    },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<b><u>{}</u></b>",
                "weekdays": "<i>{}</i>"
            }
        }
    },
    "clock#date": {
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {:%d.%m}",
        "format-alt": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {:%a, %d %b}",
        "tooltip": false
    },
    "cpu": {
        "interval": 5,
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {usage}%",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "tooltip": false,
        "on-click": "kitty -e btop"
    },
    "memory": {
        "interval": 10,
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span> {percentage}%",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
        "on-click": "kitty -e btop"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>",
            "deactivated": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='-3072'></span>"
        },
        "tooltip-format-activated": "Screen stays on",
        "tooltip-format-deactivated": "Screen may sleep"
    },
    "custom/arch": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "rofi -show drun"
    }
}
