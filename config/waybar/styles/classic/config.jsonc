// classic — one rounded pill per section (the original dotfiles bar).
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,
    "modules-left": [
        "custom/power",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/media",
        "custom/updates",
        "backlight",
        "pulseaudio",
        "network",
        "bluetooth",
        "battery",
        "custom/notifications",
        "tray",
        "custom/theme"
    ],
    "include": [
        "~/.config/waybar/modules.jsonc"
    ]
}
