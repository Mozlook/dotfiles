// mechabar — angled, stepped segments. Layout and look adapted from
// sejjy/mechabar (MIT, https://github.com/sejjy/mechabar); colors come from
// the theme palette (colors.css), modules from ../../modules.jsonc.
//
// Segments are drawn with powerline glyphs: custom/left#X / custom/right#X
// paint a slant in color X over the segment beside it, so the bg_1 → bg_2 →
// bg_3 order below must stay symmetric around the center.
{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "height": 0,
    "margin": 0,
    "spacing": 0,
    "reload_style_on_change": true,

    "include": ["~/.config/waybar/modules.jsonc"],

    "modules-left": [
        "custom/theme",
        "custom/left#bg_1",
        "hyprland/workspaces",
        "custom/right#bg_1",
        "hyprland/window"
    ],

    "modules-center": [
        "custom/left#bg_1",
        "custom/updates",
        "custom/left#bg_2",
        "memory",
        "custom/left#bg_3",
        "cpu",
        "custom/left_inverse#bg_3",

        "custom/left#accent",
        "custom/arch",
        "custom/right#accent",

        "custom/right_inverse#bg_3",
        "idle_inhibitor",
        "clock#time",
        "custom/right#bg_3",
        "clock#date",
        "custom/right#bg_2",
        "network",
        "bluetooth",
        "custom/notifications",
        "custom/right#bg_1"
    ],

    "modules-right": [
        "tray",
        "custom/media",
        "custom/left#bg_1",
        "pulseaudio",
        "custom/left#bg_2",
        "backlight",
        "custom/left#bg_3",
        "battery",
        "custom/left_inverse#bg_3",
        "custom/power"
    ],

    // --- overrides of the shared modules ------------------------------------
    "hyprland/workspaces": {
        "persistent-workspaces": { "*": 6 },
        "format": "{icon}",
        "format-icons": { "active": "", "default": "" }
    },
    "hyprland/window": {
        "max-length": 40,
        "rewrite": { "": "Desktop" }
    },
    "custom/updates": {
        "format": "󰏗 {}",
        "exec-if": "true"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤯",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"]
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" }
    },
    "backlight": {
        "format": "󰃠 {percent}%"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰉁 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "custom/theme": {
        "format": "󰏘"
    },
    "custom/power": {
        "format": "󰤄"
    },

    // --- segment dividers (powerline glyphs) ---------------------------------
    "custom/left#accent":        { "format": "", "tooltip": false },
    "custom/left#bg_1":          { "format": "", "tooltip": false },
    "custom/left#bg_2":          { "format": "", "tooltip": false },
    "custom/left#bg_3":          { "format": "", "tooltip": false },
    "custom/right#accent":       { "format": "", "tooltip": false },
    "custom/right#bg_1":         { "format": "", "tooltip": false },
    "custom/right#bg_2":         { "format": "", "tooltip": false },
    "custom/right#bg_3":         { "format": "", "tooltip": false },
    "custom/left_inverse#bg_3":  { "format": "", "tooltip": false },
    "custom/right_inverse#bg_3": { "format": "", "tooltip": false }
}
