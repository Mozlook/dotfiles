// mechabar — full-width bar of slanted segments, stepping from the accent
// color at both ends to the bar background in the middle. Inspired by
// sejjy/mechabar (MIT); colors from the theme palette, modules from
// ../../modules.jsonc.
//
// The "/" edges are a powerline glyph (U+E0BC) in custom/sl#<from>-<to>:
// drawn in the left segment's color over the right segment's background
// The power button draws its own edge (see custom/power).
// (a = accent, a2 = accent2, s0..s2 = surface0..2, bg = bar background).
{
    "layer": "top",
    "position": "top",
    "height": 0,
    "spacing": 0,
    "reload_style_on_change": true,
    "include": [
        "~/.config/waybar/modules.jsonc"
    ],
    "modules-left": [
        "custom/power",
        "clock",
        "custom/sl#s1-s0",
        "clock#date",
        "custom/sl#s0-bg"
    ],
    "modules-center": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "custom/sl#bg-s0",
        "cpu",
        "custom/sl#s0-s1",
        "pulseaudio",
        "custom/sl#s1-s2",
        "network",
        "bluetooth",
        "custom/notifications",
        "custom/sl#s2-a2",
        "battery",
        "custom/theme"
    ],
    "hyprland/workspaces": {
        "persistent-workspaces": {
            "*": 6
        },
        "format": "{icon}",
        "format-icons": {
            "active": "󰜋",
            "1": "󰧞",
            "2": "󰧞",
            "3": "󰧞",
            "4": "󰧞",
            "5": "󰧞",
            "6": "󰧞",
            "default": "󰧞"
        }
    },
    "hyprland/window": {
        "max-length": 40,
        "rewrite": {
            "": ""
        }
    },
    "clock#date": {
        "format": "{:%a %d.%m}",
        "format-alt": "{:%A, %d %B %Y}"
    },
    "network": {
        "format-wifi": "{icon}"
    },
    "bluetooth": {
        "format-connected": "<span font_desc='Material Symbols Rounded @FILL=1' size='large'></span>"
    },
    "custom/power": {
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' size='large' rise='2048'></span>  <span size='22272'></span>"
    },
    "custom/sl#s1-s0": {
        "format": "",
        "tooltip": false
    },
    "custom/sl#s0-bg": {
        "format": "",
        "tooltip": false
    },
    "custom/sl#bg-s0": {
        "format": "",
        "tooltip": false
    },
    "custom/sl#s0-s1": {
        "format": "",
        "tooltip": false
    },
    "custom/sl#s1-s2": {
        "format": "",
        "tooltip": false
    },
    "custom/sl#s2-a2": {
        "format": "",
        "tooltip": false
    }
}
