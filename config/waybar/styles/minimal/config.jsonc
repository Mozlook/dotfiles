// minimal — thin flat bar, text labels instead of icons ("cpu 7%").
// Labels are dimmed with Pango alpha so they follow any theme palette.
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "reload_style_on_change": true,
    "include": [
        "~/.config/waybar/modules.jsonc"
    ],
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/media",
        "custom/updates",
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "bluetooth",
        "backlight",
        "battery",
        "custom/notifications",
        "tray",
        "custom/theme",
        "custom/power"
    ],
    "hyprland/window": {
        "format": "{}",
        "max-length": 60,
        "rewrite": {
            "": ""
        }
    },
    "clock": {
        "format": "<span alpha='55%'>{0:%a %d %b}</span>  <b>{0:%H:%M}</b>",
        "format-alt": "<span alpha='55%'>{0:%Y-%m-%d}</span>  <b>{0:%H:%M:%S}</b>",
        "interval": 1
    },
    "custom/media": {
        "format": "<span alpha='55%'>♪</span> {}",
        "max-length": 40
    },
    "custom/updates": {
        "format": "<span alpha='55%'>upd</span> {}"
    },
    "cpu": {
        "format": "<span alpha='55%'>cpu</span> {usage}%"
    },
    "memory": {
        "format": "<span alpha='55%'>mem</span> {used:0.1f}G"
    },
    "pulseaudio": {
        "format": "<span alpha='55%'>vol</span> {volume}%",
        "format-muted": "<span alpha='55%'>vol</span> mute"
    },
    "network": {
        "format-wifi": "<span alpha='55%'>net</span> {essid}",
        "format-ethernet": "<span alpha='55%'>net</span> eth",
        "format-disconnected": "<span alpha='55%'>net</span> off",
        "max-length": 24
    },
    "bluetooth": {
        "format": "<span alpha='55%'>bt</span> on",
        "format-disabled": "<span alpha='55%'>bt</span> off",
        "format-off": "<span alpha='55%'>bt</span> off",
        "format-connected": "<span alpha='55%'>bt</span> {num_connections}"
    },
    "backlight": {
        "format": "<span alpha='55%'>bri</span> {percent}%"
    },
    "battery": {
        "format": "<span alpha='55%'>bat</span> {capacity}%",
        "format-charging": "<span alpha='55%'>bat</span> +{capacity}%",
        "format-plugged": "<span alpha='55%'>bat</span> ={capacity}%"
    },
    "custom/notifications": {
        "format": "{icon}",
        "format-icons": {
            "notification": "<span alpha='55%'>msg</span> ●",
            "none": "<span alpha='55%'>msg</span> ○",
            "dnd-notification": "<span alpha='55%'>dnd</span> ●",
            "dnd-none": "<span alpha='55%'>dnd</span> ○",
            "inhibited-notification": "<span alpha='55%'>msg</span> ●",
            "inhibited-none": "<span alpha='55%'>msg</span> ○",
            "dnd-inhibited-notification": "<span alpha='55%'>dnd</span> ●",
            "dnd-inhibited-none": "<span alpha='55%'>dnd</span> ○"
        }
    },
    "custom/theme": {
        "format": "◐"
    },
    "custom/power": {
        "format": "⏻"
    }
}
