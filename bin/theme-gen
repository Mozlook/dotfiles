#!/usr/bin/env bash
# theme-gen <image> [out-palette.json] — extract a canonical palette from a
# wallpaper using matugen, normalized into our palette.json format.
# If out is omitted, prints the JSON to stdout.
set -euo pipefail

SELF="$(readlink -f "$0")"
DOTS="$(dirname "$(dirname "$SELF")")"

img="${1:-}"
out="${2:-}"
[ -f "$img" ] || { echo "usage: theme-gen <image> [out.json]" >&2; exit 1; }

command -v matugen >/dev/null || { echo "theme-gen: matugen not installed" >&2; exit 1; }

# JSON only — --dry-run skips templates, wallpaper and reload hooks;
# --source-color-index 0 picks the dominant color without an interactive prompt.
tmp_json="$(mktemp)"
tmp="$(mktemp)"
trap 'rm -f "$tmp_json" "$tmp"' EXIT
matugen image "$img" -c "$DOTS/scripts/matugen.toml" --dry-run -q -j hex -m dark \
  --source-color-index 0 </dev/null >"$tmp_json" \
  || { echo "theme-gen: matugen failed on $img" >&2; exit 1; }

# theme name = the theme dir when writing themes/<name>/palette.json, else the image name
if [ -n "$out" ]; then name="$(basename "$(dirname "$(readlink -f "$out")")")"
else name="$(basename "$img")"; name="${name%.*}"; fi
python3 "$DOTS/scripts/matugen2palette.py" "$tmp_json" "$tmp" "$name" "$(basename "$img")" >/dev/null

if [ -n "$out" ]; then
  mkdir -p "$(dirname "$out")"
  cp "$tmp" "$out"
  echo ":: palette generated -> $out"
else
  cat "$tmp"
fi
